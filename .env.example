# Copy this file to .env for local runs. Never commit real keys.

# PayPal REST app credentials (Sandbox). From developer.paypal.com > Apps & Credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook ID from the app's Sandbox Webhooks section (used to verify PayPal's signature).
PAYPAL_WEBHOOK_ID=

# AI model. Set ONE of these. Gemini has a free tier.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Public URL of this app (used for PayPal return links). Local default shown.
PUBLIC_URL=http://localhost:3000
PORT=3000

# Password for the owner dashboard (leave blank for the open demo).
OWNER_PASSCODE=
