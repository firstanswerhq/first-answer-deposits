# Copy this file to .env for local runs. Never commit real keys.

# PayPal REST app credentials (Sandbox). From developer.paypal.com > Apps & Credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook ID from the app's Sandbox Webhooks section (used to verify PayPal's signature).
PAYPAL_WEBHOOK_ID=

# AI model. Set ONE key (with no key the app runs a scripted demo bot).
# Claude gives the best conversations. Groq and Gemini have free tiers.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
META_API_KEY=
# Optional: pick the provider when more than one key is set (anthropic | meta | groq | google), or change models.
AI_PROVIDER=
ANTHROPIC_MODEL=claude-sonnet-5-5
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_MODEL=gemini-3.5-flash-lite
META_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
META_API_BASE=https://api.llama.com/compat/v1

# Public URL of this app (used for PayPal return links). Local default shown.
PUBLIC_URL=http://localhost:3000
PORT=3000

# Password for the owner dashboard (leave blank for the open demo).
OWNER_PASSCODE=
